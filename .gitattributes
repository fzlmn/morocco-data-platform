# Normalise line endings so Windows checkouts stop producing CRLF warnings
# and diffs stay clean across machines.
* text=auto eol=lf

*.sh   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf
*.md   text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary

# GitHub's language detection weighs the notebook's committed outputs far more
# heavily than the source, reporting this as a Jupyter project. The notebook is
# documentation of the source exploration, not the deliverable.
*.ipynb      linguist-documentation
notebooks/** linguist-documentation
docs/**      linguist-documentation
